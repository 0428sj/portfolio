<?xml version="1.0" encoding="UTF-8"?>
<!-- 지도·위치추정·계획·제어 없이 센싱+장애물 분할+점유격자만 띄운다 (CPU 판 이미지) -->
<launch>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="sensor_model" default="sample_sensor_kit"/>
  <arg name="map_path" default="/home/aw/autoware_data/maps/sample-map-rosbag"/>
  <arg name="rviz" default="true"/>
  <arg name="odom" default="true" description="true: 속도+IMU 추측항법 TF / false: map=base_link 고정"/>

  <!-- 위치추정 대신 map->base_link: 추측항법(odom:=true) 또는 고정(odom:=false, 정지 시험 전용) -->
  <executable cmd="python3 /home/aw/tools/dead_reckoning.py --ros-args -p use_sim_time:=true" output="screen" if="$(var odom)"/>
  <node pkg="tf2_ros" exec="static_transform_publisher" name="map_to_base_link_static"
        args="--frame-id map --child-frame-id base_link" unless="$(var odom)">
    <param name="use_sim_time" value="true"/>
  </node>

  <include file="$(find-pkg-share autoware_launch)/launch/logging_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="vehicle" value="true"/>
    <arg name="sensing" value="true"/>
    <arg name="perception" value="true"/>
    <arg name="map" value="false"/>
    <arg name="localization" value="false"/>
    <arg name="planning" value="false"/>
    <arg name="control" value="false"/>
    <arg name="system" value="false"/>
    <arg name="rviz" value="$(var rviz)"/>
    <!-- 물체 검출·추적·예측 생략 (빈 물체 목록만 발행) -->
    <arg name="use_empty_dynamic_object_publisher" value="true"/>
    <arg name="lidar_detection_model" value="clustering"/>
    <!-- CPU 판 우회 3종 -->
    <arg name="cuda_ground_segmentation_node_param_path" value="none"/>
    <arg name="use_traffic_light_recognition" value="false"/>
    <arg name="occupancy_grid_map_method" value="laserscan_based"/>
  </include>
</launch>
